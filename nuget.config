<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="NuGet.org" value="https://api.nuget.org/v3/index.json" />
		<add key="PowerToysPublicDependencies" value="https://pkgs.dev.azure.com/shine-oss/PowerToys/_packaging/PowerToysPublicDependencies/nuget/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<!-- CommunityToolkit Labs 预发布包仅存在于上游私有源 -->
		<packageSource key="PowerToysPublicDependencies">
			<package pattern="CommunityToolkit.Labs.*" />
		</packageSource>
		<!-- 其余包全部来自 nuget.org（私有源对未缓存版本返回 401） -->
		<packageSource key="NuGet.org">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
