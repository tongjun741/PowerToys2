<?xml version="1.0" encoding="utf-8"?>
<configuration>
	<packageSources>
		<clear />
		<add key="NuGet.org" value="https://api.nuget.org/v3/index.json" />
		<add key="PowerToysPublicDependencies" value="https://pkgs.dev.azure.com/shine-oss/PowerToys/_packaging/PowerToysPublicDependencies/nuget/v3/index.json" />
	</packageSources>
	<packageSourceMapping>
		<!-- SDK 运行时包由 NuGet.org 提供（私有源对未缓存版本返回 401） -->
		<packageSource key="NuGet.org">
			<package pattern="Microsoft.NETCore.App.Runtime.*" />
			<package pattern="Microsoft.AspNetCore.App.Runtime.*" />
			<package pattern="Microsoft.WindowsDesktop.App.Runtime.*" />
			<package pattern="Microsoft.NET.ILLink.Tasks*" />
		</packageSource>
		<packageSource key="PowerToysPublicDependencies">
			<package pattern="*" />
		</packageSource>
	</packageSourceMapping>
</configuration>
